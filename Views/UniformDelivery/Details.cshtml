@using DnTech_PBS_UniformManagement.ViewModels
@model UniformDeliveryDetailsViewModel
@{
    ViewData["Title"] = "Detalles de Entrega";
}

<div class="container mt-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a asp-controller="Dashboard" asp-action="Index">Dashboard</a>
            </li>
            <li class="breadcrumb-item">@Model.ProvinceName</li>
            <li class="breadcrumb-item">
                <a asp-action="Index" asp-route-healthAreaId="@Model.HealthAreaId">@Model.HealthAreaName</a>
            </li>
            <li class="breadcrumb-item active" aria-current="page">Detalles de Entrega</li>
        </ol>
    </nav>

    <div class="row">
        <div class="col-lg-10 mx-auto">
            <div class="card shadow-custom border-0">
                <div class="card-header bg-gradient text-white">
                    <div class="d-flex justify-content-between align-items-center">
                        <h4 class="mb-0">
                            <i class="fas fa-tshirt me-2"></i>Detalles de Entrega
                        </h4>                        
                    </div>
                </div>

                <div class="card-body p-4">
                    <!-- Employee Info -->
                    <div class="row mb-4">
                        <div class="col-md-6">
                            <div class="card bg-light">
                                <div class="card-body">
                                    <h6 class="text-muted mb-3">
                                        <i class="fas fa-user me-2"></i>Información del Empleado
                                    </h6>
                                    <div class="mb-2">
                                        <strong>Nombre:</strong>
                                        <p class="mb-0">@Model.EmployeeName</p>
                                    </div>
                                    <div class="mb-2">
                                        <strong>Cédula:</strong>
                                        <p class="mb-0">
                                            @if (!string.IsNullOrEmpty(Model.EmployeeIdCard))
                                            {
                                                <span class="badge bg-secondary">@Model.EmployeeIdCard</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">N/A</span>
                                            }
                                        </p>
                                    </div>
                                    <div>
                                        <strong>Puesto:</strong>
                                        <p class="mb-0">
                                            @if (Model.EmployeePosition == "Oficinista")
                                            {
                                                <span class="badge" style="background: var(--primary-color);">
                                                    <i class="fas fa-desktop me-1"></i>Oficinista
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge" style="background: var(--secondary-color);">
                                                    <i class="fas fa-broom me-1"></i>Misceláneo
                                                </span>
                                            }
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="card bg-light">
                                <div class="card-body">
                                    <h6 class="text-muted mb-3">
                                        <i class="fas fa-calendar-alt me-2"></i>Información de Entrega
                                    </h6>
                                    <div class="mb-2">
                                        <strong>Fecha de Entrega:</strong>
                                        <p class="mb-0">
                                            <i class="fas fa-calendar me-1"></i>
                                            @Model.DeliveryDate.ToString("dddd, dd MMMM yyyy", new System.Globalization.CultureInfo("es-ES"))
                                        </p>
                                    </div>
                                    <div class="mb-2">
                                        <strong>Próxima Entrega:</strong>
                                        <p class="mb-0">
                                            @if (Model.NextDeliveryDate.HasValue)
                                            {
                                                <i class="fas fa-calendar-check me-1"></i>
                                                @Model.NextDeliveryDate.Value.ToString("dddd, dd MMMM yyyy", new System.Globalization.CultureInfo("es-ES"))
                                                @if (Model.DaysUntilNextDelivery.HasValue)
                                                {
                                                    <br>
                                                    <small class="text-muted">
                                                        (En @Model.DaysUntilNextDelivery días)
                                                    </small>
                                                }
                                            }
                                            else
                                            {
                                                <span class="text-muted">No programada</span>
                                            }
                                        </p>
                                    </div>
                                    
                                    @if (User.IsInRole("Administrator") || User.IsInRole("Supervisor"))
                                    {
                                        <!-- Selector de estado editable -->
                                        <div class="mb-0">
                                            <strong>Estado:</strong>
                                            <form asp-action="UpdateStatus" method="post" id="statusForm" class="mt-2">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="deliveryId" value="@Model.DeliveryId" />
                                                <input type="hidden" name="healthAreaId" value="@Model.HealthAreaId" />
                                                
                                                <select name="status" class="form-select form-select-sm" id="statusSelect" onchange="document.getElementById('statusForm').submit()">
                                                    <option value="NotDelivered" selected="@(Model.Status == "Sin entrega")">
                                                        🔴 Sin entrega
                                                    </option>
                                                    <option value="Delivered" selected="@(Model.Status == "Entregado")">
                                                        ✅ Entregado
                                                    </option>
                                                    <option value="Upcoming" selected="@(Model.Status == "Próximo")">
                                                        ⏰ Próximo
                                                    </option>
                                                </select>
                                                <small class="text-muted d-block mt-1">
                                                    <i class="fas fa-info-circle"></i> Selecciona para cambiar el estado
                                                </small>
                                            </form>
                                        </div>
                                    }
                                    else
                                    {
                                        <!-- Solo visualización para empleados -->
                                        <div class="mb-0">
                                            <strong>Estado:</strong>
                                            <p class="mb-0 mt-2">
                                                @if (Model.Status == "Entregado")
                                                {
                                                    <span class="badge bg-success">
                                                        <i class="fas fa-check-circle me-1"></i>Entregado
                                                    </span>
                                                }
                                                else if (Model.Status == "Próximo")
                                                {
                                                    <span class="badge bg-warning text-dark">
                                                        <i class="fas fa-clock me-1"></i>Próximo
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">
                                                        <i class="fas fa-times-circle me-1"></i>Sin entrega
                                                    </span>
                                                }
                                            </p>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Observations -->
                    @if (!string.IsNullOrEmpty(Model.Observations))
                    {
                        <div class="alert alert-info mb-4">
                            <strong><i class="fas fa-comment me-2"></i>Observaciones:</strong>
                            <p class="mb-0 mt-2">@Model.Observations</p>
                        </div>
                    }

                    <hr class="my-4">

                    <!-- Delivery Details -->
                    <h5 class="mb-3">
                        <i class="fas fa-list me-2"></i>Prendas Entregadas
                        <span class="badge bg-secondary ms-2">@Model.Details.Count</span>
                    </h5>

                    @if (Model.Details.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead class="bg-light">
                                    <tr>
                                        <th>#</th>
                                        <th><i class="fas fa-tshirt me-2"></i>Tipo de Prenda</th>
                                        <th><i class="fas fa-ruler me-2"></i>Talla</th>
                                        <th><i class="fas fa-sort-numeric-up me-2"></i>Cantidad</th>
                                        <th><i class="fas fa-sticky-note me-2"></i>Notas</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (int i = 0; i < Model.Details.Count; i++)
                                    {
                                        var detail = Model.Details[i];
                                        <tr>
                                            <td>@(i + 1)</td>
                                            <td>
                                                <strong>@detail.GarmentType</strong>
                                            </td>
                                            <td>
                                                <span class="badge bg-secondary">@detail.Size</span>
                                            </td>
                                            <td>
                                                <span class="badge" style="background: var(--primary-color);">
                                                    @detail.Quantity
                                                </span>
                                            </td>
                                            <td>
                                                @if (!string.IsNullOrEmpty(detail.Notes))
                                                {
                                                    <small class="text-muted">@detail.Notes</small>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">-</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot class="bg-light">
                                    <tr>
                                        <td colspan="3" class="text-end"><strong>Total de prendas:</strong></td>
                                        <td colspan="2">
                                            <strong class="text-primary">
                                                @Model.Details.Sum(d => d.Quantity) unidades
                                            </strong>
                                        </td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning">
                            <i class="fas fa-exclamation-triangle me-2"></i>
                            No hay prendas registradas en esta entrega.
                        </div>
                    }

                    <!-- Additional Info -->
                    <div class="mt-4">
                        <small class="text-muted">
                            <i class="fas fa-clock me-1"></i>
                            Registrado el: @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                        </small>
                    </div>

                    <!-- Actions -->
                    <div class="d-flex gap-2 mt-4">
                        <a asp-action="Index" 
                           asp-route-healthAreaId="@Model.HealthAreaId" 
                           class="btn btn-outline-secondary">
                            <i class="fas fa-arrow-left me-2"></i>Volver
                        </a>
                        <a asp-action="History" 
                           asp-route-employeeId="@Model.EmployeeId" 
                           asp-route-healthAreaId="@Model.HealthAreaId"
                           class="btn btn-outline-info">
                            <i class="fas fa-history me-2"></i>Ver Historial Completo
                        </a>
                        @if (User.IsInRole("Administrator"))
                        {
                            <button type="button" 
                                    class="btn btn-outline-danger ms-auto" 
                                    data-bs-toggle="modal" 
                                    data-bs-target="#deleteModal">
                                <i class="fas fa-trash me-2"></i>Eliminar Entrega
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Delete Modal -->
@if (User.IsInRole("Administrator"))
{
    <div class="modal fade" id="deleteModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="fas fa-exclamation-triangle text-danger me-2"></i>
                        Confirmar Eliminación
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p>¿Está seguro de que desea eliminar esta entrega?</p>
                    <div class="alert alert-warning mb-0">
                        <i class="fas fa-info-circle me-2"></i>
                        <strong>Advertencia:</strong> Esta acción no se puede deshacer.
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <i class="fas fa-times me-2"></i>Cancelar
                    </button>
                    <form asp-action="Delete" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.DeliveryId" />
                        <input type="hidden" name="healthAreaId" value="@Model.HealthAreaId" />
                        <button type="submit" class="btn btn-danger">
                            <i class="fas fa-trash me-2"></i>Eliminar
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}

@section Styles {
    <link rel="stylesheet" href="/css/uniform-delivery.css" asp-append-version="true" />
}