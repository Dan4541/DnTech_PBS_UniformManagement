@using DnTech_PBS_UniformManagement.Models.Enums
@using DnTech_PBS_UniformManagement.ViewModels
@model List<EmployeeWithUniformsViewModel>
@{
    ViewData["Title"] = "Gestión de Uniformes";
}

<div class="container mt-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a asp-controller="Dashboard" asp-action="Index">Dashboard</a>
            </li>
            <li class="breadcrumb-item">@ViewBag.ProvinceName</li>
            <li class="breadcrumb-item active" aria-current="page">@ViewBag.HealthAreaName</li>
        </ol>
    </nav>

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="text-gradient mb-1">
                <i class="fas fa-hospital me-2"></i>@ViewBag.HealthAreaName
            </h2>
            <p class="text-muted mb-0">
                <i class="fas fa-barcode me-1"></i>
                Código: @ViewBag.HealthAreaCode |
                <i class="fas fa-users me-1"></i>
                @Model.Count empleado@(Model.Count != 1 ? "s" : "")
            </p>
        </div>
        <div class="d-flex gap-2">
            @if (User.IsInRole("Administrator") || User.IsInRole("Supervisor"))
            {
                <a asp-controller="Dashboard"
                   asp-action="AssignEmployee"
                   asp-route-healthAreaId="@ViewBag.HealthAreaId"
                   class="btn btn-outline-success">
                    <i class="fas fa-user-plus me-2"></i>
                    <span class="d-none d-sm-inline">Assign Employee</span>
                    <span class="d-inline d-sm-none">Assign</span>
                </a>
            }
            <a asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left me-2"></i>
                <span class="d-none d-sm-inline">Volver</span>
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i>
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Employees Table -->
    @if (Model.Any())
    {
        <div class="card shadow-custom border-0">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0" id="employeesTable">
                        <thead class="bg-light">
                            <tr>
                                <th><i class="fas fa-user me-2"></i>Empleado</th>
                                <th><i class="fas fa-id-card me-2"></i>Cédula</th>
                                <th><i class="fas fa-briefcase me-2"></i>Puesto</th>
                                <th><i class="fas fa-calendar me-2"></i>Última Entrega</th>
                                <th><i class="fas fa-calendar-alt me-2"></i>Próxima Entrega</th>
                                <th><i class="fas fa-info-circle me-2"></i>Estado</th>
                                <th class="text-center"><i class="fas fa-cog me-2"></i>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var employee in Model)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="employee-avatar me-2">
                                                <i class="fas fa-user text-white"></i>
                                            </div>
                                            <div>
                                                <div class="fw-bold">@employee.FullName</div>
                                                <small class="text-muted">@employee.Email</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(employee.IdCard))
                                        {
                                            <span class="badge bg-secondary">@employee.IdCard</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">N/A</span>
                                        }
                                    </td>
                                    <td>
                                        @if (employee.Position == EmployeePosition.OfficeWorker)
                                        {
                                            <span class="badge badge-oficinista">
                                                <i class="fas fa-desktop me-1"></i>Oficinista
                                            </span>
                                        }
                                        else if (employee.Position == EmployeePosition.Miscellaneous)
                                        {
                                            <span class="badge badge-miscelaneo">
                                                <i class="fas fa-broom me-1"></i>Misceláneo
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">N/A</span>
                                        }
                                    </td>
                                    <td>
                                        @if (employee.LastDeliveryDate.HasValue)
                                        {
                                            <span>@employee.LastDeliveryDate.Value.ToString("dd/MM/yyyy")</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Sin registro</span>
                                        }
                                    </td>
                                    <td>
                                        @if (employee.NextDeliveryDate.HasValue)
                                        {
                                            <span>@employee.NextDeliveryDate.Value.ToString("dd/MM/yyyy")</span>
                                            @if (employee.DaysUntilNextDelivery.HasValue)
                                            {
                                                <br>
                                                <small class="text-muted">
                                                    (@employee.DaysUntilNextDelivery días)
                                                </small>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td>
                                        @if (employee.DeliveryStatus == "Entregado")
                                        {
                                            <span class="badge bg-success">
                                                <i class="fas fa-check-circle me-1"></i>Entregado
                                            </span>
                                        }
                                        else if (employee.DeliveryStatus == "Próximo")
                                        {
                                            <span class="badge bg-warning text-dark">
                                                <i class="fas fa-clock me-1"></i>Próximo
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                <i class="fas fa-times-circle me-1"></i>Sin entrega
                                            </span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group btn-group-sm" role="group">
                                            @if (User.IsInRole("Administrator") || User.IsInRole("Supervisor"))
                                            {
                                                <a asp-action="Create"
                                                   asp-route-employeeId="@employee.EmployeeId"
                                                   asp-route-healthAreaId="@employee.HealthAreaId"
                                                   class="btn btn-outline-primary"
                                                   title="Nueva Entrega">
                                                    <i class="fas fa-plus"></i>
                                                </a>
                                            }
                                            <a asp-action="History"
                                               asp-route-employeeId="@employee.EmployeeId"
                                               asp-route-healthAreaId="@employee.HealthAreaId"
                                               class="btn btn-outline-info"
                                               title="Ver Historial">
                                                <i class="fas fa-history"></i>
                                            </a>
                                            @if (employee.LastDeliveryId.HasValue)
                                            {
                                                <a asp-action="Details"
                                                   asp-route-id="@employee.LastDeliveryId"
                                                   class="btn btn-outline-success"
                                                   title="Ver Última Entrega">
                                                    <i class="fas fa-eye"></i>
                                                </a>
                                            }
                                            @if (User.IsInRole("Administrator") || User.IsInRole("Supervisor"))
                                            {
                                                <button type="button"
                                                        class="btn btn-outline-danger"
                                                        onclick="confirmRemove('@employee.EmployeeId', '@employee.FullName')"
                                                        title="Remover Empleado">
                                                    <i class="fas fa-user-times"></i>
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="card shadow-custom border-0">
            <div class="card-body text-center py-5">
                <i class="fas fa-users fa-4x text-muted mb-4 opacity-25"></i>
                <h4 class="text-muted mb-3">No hay empleados asignados</h4>
                <p class="text-muted mb-4">Agrega empleados a esta área de salud para gestionar sus uniformes</p>
                <a asp-controller="Dashboard" asp-action="AssignEmployee"
                   asp-route-healthAreaId="@ViewBag.HealthAreaId"
                   class="btn btn-custom btn-gradient">
                    <i class="fas fa-user-plus me-2"></i>Asignar Empleado
                </a>
            </div>
        </div>
    }
</div>

<!-- Remove Employee Modal -->
@if (User.IsInRole("Administrator") || User.IsInRole("Supervisor"))
{
    <div class="modal fade" id="removeModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="fas fa-exclamation-triangle text-warning me-2"></i>
                        Confirmar Remoción
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p>¿Está seguro de que desea remover a <strong id="removeEmployeeName"></strong> de esta área de salud?</p>
                    <div class="alert alert-warning mb-0">
                        <i class="fas fa-info-circle me-2"></i>
                        <strong>Nota:</strong> El empleado y su historial de uniformes serán eliminados.
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <i class="fas fa-times me-2"></i>Cancelar
                    </button>
                    <form id="removeForm" asp-controller="Dashboard" asp-action="RemoveEmployee" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="healthAreaId" value="@ViewBag.HealthAreaId" />
                        <input type="hidden" name="employeeId" id="removeEmployeeId" />
                        <button type="submit" class="btn btn-danger">
                            <i class="fas fa-user-times me-2"></i>Remover
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}

@section Styles {
    <link rel="stylesheet" href="/css/uniform-delivery.css" asp-append-version="true" />
}

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#employeesTable').DataTable({
                "language": {
                    "url": "https://cdn.datatables.net/plug-ins/1.13.8/i18n/es-ES.json"
                },
                "pageLength": 5,
                "lengthMenu": [5, 10, 25, 50]
            });
        });

        function confirmRemove(employeeId, employeeName) {
            document.getElementById('removeEmployeeName').textContent = employeeName;
            document.getElementById('removeEmployeeId').value = employeeId;
            new bootstrap.Modal(document.getElementById('removeModal')).show();
        }
    </script>
}