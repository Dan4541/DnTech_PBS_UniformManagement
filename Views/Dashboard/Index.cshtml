@using DnTech_PBS_UniformManagement.ViewModels
@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<!-- Stats Cards -->
<div class="container mt-4">
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card shadow-custom border-0">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-2">Provinces</h6>
                            <h2 class="mb-0 fw-bold">@Model.TotalProvinces</h2>
                        </div>
                        <div class="rounded-circle p-3" style="background: rgba(6, 182, 212, 0.1);">
                            <i class="fas fa-map-marked-alt fa-2x" style="color: var(--primary-color);"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-custom border-0">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-2">Health Areas</h6>
                            <h2 class="mb-0 fw-bold">@Model.TotalHealthAreas</h2>
                        </div>
                        <div class="rounded-circle p-3" style="background: rgba(16, 185, 129, 0.1);">
                            <i class="fas fa-hospital fa-2x" style="color: var(--secondary-color);"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-custom border-0">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-2">Employees</h6>
                            <h2 class="mb-0 fw-bold">@Model.TotalEmployees</h2>
                        </div>
                        <div class="rounded-circle p-3" style="background: rgba(20, 184, 166, 0.1);">
                            <i class="fas fa-users fa-2x" style="color: var(--accent-color);"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-custom border-0">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-2">Total Users</h6>
                            <h2 class="mb-0 fw-bold">@Model.TotalUsers</h2>
                        </div>
                        <div class="rounded-circle p-3" style="background: rgba(6, 182, 212, 0.1);">
                            <i class="fas fa-user-shield fa-2x" style="color: var(--primary-color);"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Header with Add Province Button -->
    <div class="d-flex justify-content-between align-items-start align-items-md-center mb-4 flex-column flex-md-row gap-3">
        <div>
            <h2 class="text-gradient mb-1">
                <i class="fas fa-map-marked-alt me-2"></i>
                <span class="d-none d-md-inline">Provinces & Health Areas</span>
                <span class="d-inline d-md-none">Provinces</span>
            </h2>
            <p class="text-muted mb-0 d-none d-sm-block">Manage provinces, health areas and employee assignments</p>
        </div>
        @if (User.IsInRole("Administrator"))
        {
            <a asp-action="CreateProvince" class="btn btn-custom btn-gradient w-100 w-md-auto">
                <i class="fas fa-plus-circle me-2"></i>
                <span class="d-none d-sm-inline">Add Province</span>
                <span class="d-inline d-sm-none">ADD</span>
            </a>
        }
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i>
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Provinces List - Improved Design -->
    @if (Model.Provinces.Any())
    {
        <div class="row">
            <div class="col-12">
                <div class="card shadow-custom border-0">
                    <div class="card-body p-0">
                        @foreach (var province in Model.Provinces)
                        {
                            <div class="province-item border-bottom">
                                <!-- Province Header - Responsive optimizado -->
                                <div class="province-header p-3 p-md-4 d-flex justify-content-between align-items-center"
                                     style="cursor: pointer; transition: all 0.3s ease;"
                                     onclick="toggleProvince('@province.Id')">

                                    <div class="d-flex align-items-center flex-grow-1">
                                        <!-- Ícono oculto en móvil, visible en desktop -->
                                        <div class="province-icon me-3 d-none d-md-block">
                                            <div class="rounded-circle d-flex align-items-center justify-content-center"
                                                 style="width: 60px; height: 60px; background: var(--gradient-1);">
                                                <i class="fas fa-map-marker-alt fa-2x text-white"></i>
                                            </div>
                                        </div>
                                        <div class="flex-grow-1">
                                            <h4 class="mb-1 fw-bold">@province.Name</h4>
                                            <div class="d-flex gap-3 flex-wrap">
                                                @if (!string.IsNullOrEmpty(province.Code))
                                                {
                                                    <small class="text-muted">
                                                        <i class="fas fa-barcode me-1"></i>
                                                        Code: @province.Code
                                                    </small>
                                                }
                                                <small class="text-muted">
                                                    <i class="fas fa-hospital me-1"></i>
                                                    @province.HealthAreasCount @(province.HealthAreasCount == 1 ? "Health Area" : "Health Areas")
                                                </small>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="d-flex align-items-center gap-2 flex-shrink-0">
                                        @if (User.IsInRole("Administrator") || User.IsInRole("Supervisor"))
                                        {
                                            <a asp-action="CreateHealthArea"
                                               asp-route-provinceId="@province.Id"
                                               class="btn btn-sm btn-outline-primary"
                                               onclick="event.stopPropagation()">
                                                <i class="fas fa-plus me-1"></i>
                                                <span class="d-none d-md-inline">Add Area</span>
                                            </a>
                                        }
                                        @if (User.IsInRole("Administrator"))
                                        {
                                            <div class="btn-group btn-group-sm" onclick="event.stopPropagation()">
                                                <a asp-action="EditProvince"
                                                   asp-route-id="@province.Id"
                                                   class="btn btn-outline-warning"
                                                   title="Edit Province">
                                                    <i class="fas fa-edit"></i>
                                                </a>
                                                <button type="button"
                                                        class="btn btn-outline-danger"
                                                        onclick="confirmDeleteProvince(@province.Id, '@province.Name')"
                                                        title="Delete Province">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </div>
                                        }
                                    </div>
                                </div>

                                <!-- Health Areas List (Collapsible) -->
                                <div class="province-content collapse" id="province-@province.Id">
                                    @if (province.HealthAreas.Any())
                                    {
                                        <div class="table-responsive">
                                            <table class="table table-hover mb-0">
                                                <thead class="bg-light">
                                                    <tr>
                                                        <th class="ps-3 ps-md-4">
                                                            <i class="fas fa-hospital me-2"></i>
                                                            <span class="d-none d-sm-inline">Health Area</span>
                                                            <span class="d-inline d-sm-none">Area</span>
                                                        </th>
                                                        <th class="d-none d-sm-table-cell">
                                                            <i class="fas fa-barcode me-2"></i>Code
                                                        </th>
                                                        <th>
                                                            <i class="fas fa-users me-2"></i>
                                                            <span class="d-none d-md-inline">Employees</span>
                                                            <span class="d-inline d-md-none">Emp</span>
                                                        </th>
                                                        <th class="text-center">Actions</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var healthArea in province.HealthAreas)
                                                    {
                                                        <tr>
                                                            <td class="ps-3 ps-md-4">
                                                                <a asp-controller="UniformDelivery"
                                                                   asp-action="Index"
                                                                   asp-route-healthAreaId="@healthArea.Id"
                                                                   class="text-decoration-none fw-bold"
                                                                   style="color: var(--primary-color);">
                                                                    @healthArea.Name
                                                                </a>
                                                                @if (!string.IsNullOrEmpty(healthArea.Code))
                                                                {
                                                                    <div class="d-sm-none">
                                                                        <small class="badge bg-secondary mt-1">@healthArea.Code</small>
                                                                    </div>
                                                                }
                                                            </td>
                                                            <td class="d-none d-sm-table-cell">
                                                                @if (!string.IsNullOrEmpty(healthArea.Code))
                                                                {
                                                                    <span class="badge bg-secondary">@healthArea.Code</span>
                                                                }
                                                                else
                                                                {
                                                                    <span class="text-muted">N/A</span>
                                                                }
                                                            </td>
                                                            <td>
                                                                <span class="badge" style="background: var(--gradient-1);">
                                                                    @healthArea.EmployeesCount
                                                                </span>
                                                            </td>
                                                            <td class="text-center">
                                                                <div class="btn-group btn-group-sm" role="group">
                                                                    <a asp-controller="UniformDelivery"
                                                                       asp-action="Index"
                                                                       asp-route-healthAreaId="@healthArea.Id"
                                                                       class="btn btn-outline-primary"
                                                                       title="View Details">
                                                                        <i class="fas fa-eye"></i>
                                                                    </a>
                                                                    @if (User.IsInRole("Administrator") || User.IsInRole("Supervisor"))
                                                                    {
                                                                        <a asp-action="AssignEmployee"
                                                                           asp-route-healthAreaId="@healthArea.Id"
                                                                           class="btn btn-outline-success d-none d-lg-inline-block"
                                                                           title="Assign Employee">
                                                                            <i class="fas fa-user-plus"></i>
                                                                        </a>
                                                                    }
                                                                    @if (User.IsInRole("Administrator"))
                                                                    {
                                                                        <a asp-action="EditHealthArea"
                                                                           asp-route-id="@healthArea.Id"
                                                                           class="btn btn-outline-warning"
                                                                           title="Edit Health Area">
                                                                            <i class="fas fa-edit"></i>
                                                                        </a>
                                                                        <button type="button"
                                                                                class="btn btn-outline-danger"
                                                                                onclick="confirmDeleteHealthArea(@healthArea.Id, '@healthArea.Name')"
                                                                                title="Delete Health Area">
                                                                            <i class="fas fa-trash"></i>
                                                                        </button>
                                                                    }
                                                                </div>
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="p-3 p-md-4 text-center bg-light">
                                            <i class="fas fa-hospital fa-2x text-muted mb-2 opacity-25"></i>
                                            <p class="text-muted mb-2">No health areas in this province yet</p>
                                            @if (User.IsInRole("Administrator") || User.IsInRole("Supervisor"))
                                            {
                                                <a asp-action="CreateHealthArea"
                                                   asp-route-provinceId="@province.Id"
                                                   class="btn btn-sm btn-outline-primary">
                                                    <i class="fas fa-plus me-1"></i>
                                                    Add First Health Area
                                                </a>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="card shadow-custom border-0">
            <div class="card-body text-center py-5">
                <i class="fas fa-map-marked-alt fa-4x text-muted mb-4 opacity-25"></i>
                <h4 class="text-muted mb-3">No Provinces Yet</h4>
                <p class="text-muted mb-4">Start by creating your first province</p>
                @if (User.IsInRole("Administrator") || User.IsInRole("Supervisor"))
                {
                    <a asp-action="CreateProvince" class="btn btn-custom btn-gradient">
                        <i class="fas fa-plus-circle me-2"></i>
                        Create First Province
                    </a>
                }
            </div>
        </div>
    }

    <!-- Modal Delete Province -->
    <div class="modal fade" id="deleteProvinceModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="fas fa-exclamation-triangle text-danger me-2"></i>
                        Confirm Delete Province
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to delete the province <strong id="deleteProvinceName"></strong>?</p>
                    <div class="alert alert-warning mb-0">
                        <i class="fas fa-info-circle me-2"></i>
                        <strong>Note:</strong> You cannot delete a province that has health areas. Remove all health areas first.
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <i class="fas fa-times me-2"></i>Cancel
                    </button>
                    <form id="deleteProvinceForm" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-danger">
                            <i class="fas fa-trash me-2"></i>Delete Province
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal Delete Health Area -->
    <div class="modal fade" id="deleteHealthAreaModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="fas fa-exclamation-triangle text-danger me-2"></i>
                        Confirm Delete Health Area
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to delete the health area <strong id="deleteHealthAreaName"></strong>?</p>
                    <div class="alert alert-warning mb-0">
                        <i class="fas fa-info-circle me-2"></i>
                        <strong>Note:</strong> You cannot delete a health area with assigned employees. Remove all employees first.
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <i class="fas fa-times me-2"></i>Cancel
                    </button>
                    <form id="deleteHealthAreaForm" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-danger">
                            <i class="fas fa-trash me-2"></i>Delete Health Area
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function toggleProvince(provinceId) {
            const content = document.getElementById('province-' + provinceId);

            // Toggle collapse
            const bsCollapse = new bootstrap.Collapse(content, {
                toggle: true
            });
        }

        // Confirm delete province
        function confirmDeleteProvince(provinceId, provinceName) {
            document.getElementById('deleteProvinceName').textContent = provinceName;
            document.getElementById('deleteProvinceForm').action = '/Dashboard/DeleteProvince/' + provinceId;
            new bootstrap.Modal(document.getElementById('deleteProvinceModal')).show();
        }

        // Confirm delete health area
        function confirmDeleteHealthArea(healthAreaId, healthAreaName) {
            document.getElementById('deleteHealthAreaName').textContent = healthAreaName;
            document.getElementById('deleteHealthAreaForm').action = '/Dashboard/DeleteHealthArea/' + healthAreaId;
            new bootstrap.Modal(document.getElementById('deleteHealthAreaModal')).show();
        }

        // Add hover effect to province headers
        document.querySelectorAll('.province-header').forEach(header => {
            header.addEventListener('mouseenter', function() {
                this.style.backgroundColor = '#f8fafc';
            });
            header.addEventListener('mouseleave', function() {
                this.style.backgroundColor = 'transparent';
            });
        });
    </script>
}